RUNNER_SERVICE_TOKEN=replace-with-a-random-token-at-least-32-characters-long
RUNNER_ALLOWED_TARGET_HOSTS=sfm-backend,sfm-be,localhost,127.0.0.1,::1,host.docker.internal,sfmbe.duckdns.org
RUNNER_PRODUCTION_TARGET_HOSTS=sfmbe.duckdns.org
RUNNER_MAX_REQUESTS_PER_SECOND=1000
DASHBOARD_PORT=4173
LOCAL_BACKEND_URL=http://host.docker.internal:8080
LOCAL_PROMETHEUS_URL=http://sfm-prometheus:9090
PRODUCTION_BACKEND_URL=https://sfmbe.duckdns.org
PRODUCTION_PROMETHEUS_URL=http://127.0.0.1:19090
PROMETHEUS_SFM_BE_JOB=sfm-be
PRODUCTION_MAX_VUS=25
PRODUCTION_MAX_REQUESTS_PER_SECOND=25
PRODUCTION_MAX_DURATION_SECONDS=120

# Production SSH tunnel. Provide a verified SSH host fingerprint in secrets/known_hosts.
PRODUCTION_SSH_HOST=
PRODUCTION_SSH_USER=
PRODUCTION_SSH_PORT=22
PRODUCTION_SSH_LOCAL_PORT=19090
PRODUCTION_PROMETHEUS_REMOTE_HOST=
PRODUCTION_PROMETHEUS_REMOTE_PORT=0
# Files are mounted read-only from ./secrets into /run/ssh-secrets in the container.
# Place the private key at ./secrets/production_key and verified known_hosts at ./secrets/known_hosts.

# Optional overrides; Docker Compose provides internal defaults.
# SFM_DOCKER_NETWORK=sfm-network
# SFM_BE_URL=http://host.docker.internal:8080
# K6_PROMETHEUS_RW_SERVER_URL=http://sfm-prometheus:9090/api/v1/write
# K6_PROMETHEUS_RW_TREND_STATS=p(95)
