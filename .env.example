RUNNER_SERVICE_TOKEN=replace-with-a-random-token-at-least-32-characters-long
RUNNER_ALLOWED_TARGET_HOSTS=sfm-backend,sfm-be,localhost,127.0.0.1,::1,host.docker.internal
DASHBOARD_PORT=4173
DASHBOARD_ALLOWED_TARGET_URLS=https://sfmbe.duckdns.org,http://host.docker.internal:8080
DASHBOARD_DEFAULT_TARGET_URL=https://sfmbe.duckdns.org

# Optional overrides; Docker Compose provides internal defaults.
# SFM_DOCKER_NETWORK=sfm-network
# SFM_BE_URL=http://sfm-backend:8080
# K6_PROMETHEUS_RW_SERVER_URL=http://sfm-prometheus:9090/api/v1/write
# K6_PROMETHEUS_RW_TREND_STATS=p(95)
